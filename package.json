{
  "name": "examora",
  "private": true,
  "version": "2.21.0",
  "type": "module",
  "scripts": {
    "postinstall": "tsx scripts/generate-questions.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "dev": "npm run bootstrap && concurrently -k -n API,WEB \"tsx watch server/index.ts\" \"vite\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run questions:build && npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "lint:types": "tsc -p tsconfig.json --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "questions:build": "tsx scripts/generate-questions.ts",
    "seed": "tsx scripts/bootstrap.ts"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.12",
    "@prisma/client": "^6.15.0",
    "@tanstack/react-query": "^5.85.3",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.536.0",
    "nanoid": "^5.1.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prisma": "^6.15.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
